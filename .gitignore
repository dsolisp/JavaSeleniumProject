# ═══════════════════════════════════════════════════════════════════════════════
# JavaSeleniumProject .gitignore
# 7 Laws of QA Automation — Law 3: Repeatability (no local state committed)
# ADR-009: Auth state must never be committed
# ═══════════════════════════════════════════════════════════════════════════════

# ── Maven build output ────────────────────────────────────────────────────────
/target/
*.class

# ── Test results and reports ──────────────────────────────────────────────────
/allure-results/
/reports/
/test_results/

# ── Test artifacts ────────────────────────────────────────────────────────────
/diffs/
/screenshots/
# NOTE: Visual baselines must be committed for true regression testing.

# ── Auth state (ADR-009) ──────────────────────────────────────────────────────
/.auth/

# AI heal cache (ADR-019)
.ai-heal-cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
/logs/
*.log

# ── IDE files ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Database artifacts ────────────────────────────────────────────────────────
*.db
*.sqlite
app.db

# ── Temporary / debug files ────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~
*.sh.bak
run-sauce.sh
ARCHITECTURE_REVIEW_TASKS.md
